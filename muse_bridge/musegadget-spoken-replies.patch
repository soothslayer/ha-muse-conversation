+"""Exercise BlueZ callbacks without a Linux D-Bus installation."""
+import importlib.util
+from pathlib import Path
+from types import ModuleType, SimpleNamespace
+from unittest.mock import Mock
+
+import pytest
+
+
+@pytest.fixture
+def ble(monkeypatch):
+    dbus = ModuleType("dbus")
