diff --git a/linux/tests/test_chat_reply.py b/linux/tests/test_chat_reply.py
new file mode 100644
index 0000000..a531204
--- /dev/null
+++ b/linux/tests/test_chat_reply.py
@@ -0,0 +1,153 @@
+# SPDX-License-Identifier: Apache-2.0
+# Reply protocol adapted from the Meta Muse gadget SDK ESP32 chat session.
+
+"""Reply framing, correlation and completion without account credentials."""
+
+import asyncio
+import json
+
+import pytest
+from musegadget.chat_reply import ChatReply
+from musegadget.noise import ApplicationResponse, BodyChunk, ServiceFrame
+
+
+def event(kind="message.assistant", mid="answer", parent="user", **payload):
+    return {
+        "type": "event",
+        "event": kind,
+        "payload": {"message_id": mid, "reply_to_message_id": parent, **payload},
+    }
+
+
+def feed(reply, *events):
+    reply.on_frame(
+        ServiceFrame.body_chunk(
+            1, BodyChunk(data=b"".join(json.dumps(e).encode() + b"\n" for e in events))
+        )
+    )
+
+
+def answer(reply, monkeypatch):
+    monkeypatch.setattr("musegadget.chat_reply.SETTLE_S", 0.001)
+    return asyncio.run(asyncio.wait_for(reply.wait_text(), 0.1))
+
+
+def test_pre_ack_events_fragments_duplicates_and_final_text(monkeypatch):
+    async def scenario():
+        reply = ChatReply()
+        events = [
+            event("delta.message_start"),
+            event("delta.text_append", parent=None, text="Part"),
+            event("delta.message_done", parent=None, display_text="Full answer café"),
+        ]
+        data = b"".join(
+            json.dumps(e, ensure_ascii=False).encode() + b"\n" for e in events
+        )
+        for byte in data:
+            reply.on_frame(ServiceFrame.body_chunk(1, BodyChunk(data=bytes([byte]))))
+        reply.bind_ack({"result": {"message_id": "user"}})
+        feed(reply, event(content="duplicate"))
+        assert await asyncio.wait_for(reply.wait_text(), 0.1) == "Full answer café"
+
+    monkeypatch.setattr("musegadget.chat_reply.SETTLE_S", 0.001)
+    asyncio.run(scenario())
+
+
+def test_unrelated_and_unattributed_messages_never_spoken(monkeypatch):
+    async def scenario():
+        reply = ChatReply()
+        feed(
+            reply,
+            event(mid="bad", parent="other-user", content="Private"),
+            event(mid="unknown", parent=None, content="Private"),
+        )
+        reply.bind_ack({"message_id": "user"})
+        feed(
+            reply,
+            event("delta.text_append", mid="bad", parent=None, text="Still private"),
+            event(mid="ok", content="Correct"),
+            event(mid="followup", parent="ok", content="Second message"),
+        )
+        assert (
+            await asyncio.wait_for(reply.wait_text(), 0.1)
+            == "Correct\n\nSecond message"
+        )
+
+    monkeypatch.setattr("musegadget.chat_reply.SETTLE_S", 0.001)
+    asyncio.run(scenario())
+
+
+def test_sequence_replay_does_not_duplicate_deltas(monkeypatch):
+    async def scenario():
+        reply = ChatReply()
+        reply.bind_ack({"message_id": "user"})
+        start = {**event("delta.message_start"), "seq": 1}
+        delta = {**event("delta.text_append", text="Hello"), "seq": 2}
+        feed(reply, start, delta, delta, {**event("delta.message_done"), "seq": 3})
+        assert await asyncio.wait_for(reply.wait_text(), 0.1) == "Hello"
+
+    monkeypatch.setattr("musegadget.chat_reply.SETTLE_S", 0.001)
+    asyncio.run(scenario())
+
+
+@pytest.mark.parametrize("ack", [None, [], {"accepted": True}])
+def test_missing_ack_identity_fails(ack):
+    async def scenario():
+        reply = ChatReply()
+        reply.bind_ack(ack)
+        with pytest.raises(ConnectionError, match="message ID"):
+            await reply.wait_text()
+
+    asyncio.run(scenario())
+
+
+@pytest.mark.parametrize("data", [b"not-json\n", b"\xff\n", b"x" * 65537])
+def test_bad_ndjson_fails(data):
+    async def scenario():
+        reply = ChatReply()
+        reply.on_frame(ServiceFrame.body_chunk(1, BodyChunk(data=data)))
+        with pytest.raises(ConnectionError):
+            await reply.wait_text()
+
+    asyncio.run(scenario())
+
+
+def test_reply_limit_and_pre_ack_buffer_are_bounded():
+    async def scenario():
+        reply = ChatReply()
+        reply.bind_ack({"message_id": "user"})
+        feed(reply, event(content="x" * 8193))
+        with pytest.raises(ConnectionError, match="too long"):
+            await reply.wait_text()
+        reply = ChatReply()
+        for _ in range(513):
+            feed(reply, event(content="x"))
+        with pytest.raises(ConnectionError, match="Too many"):
+            await reply.wait_text()
+
+    asyncio.run(scenario())
+
+
+def test_unfinished_reply_waits_and_subscription_failure_wakes_waiter():
+    async def scenario():
+        reply = ChatReply()
+        reply.bind_ack({"message_id": "user"})
+        feed(reply, event("delta.text_append", text="Partial"))
+        task = asyncio.create_task(reply.wait_text())
+        await asyncio.sleep(0.01)
+        assert not task.done()
+        reply.fail("disconnected")
+        with pytest.raises(ConnectionError, match="disconnected"):
+            await task
+
+    asyncio.run(scenario())
+
+
+def test_subscription_rejection_before_send():
+    async def scenario():
+        reply = ChatReply()
+        reply.on_frame(ServiceFrame.response(1, ApplicationResponse(status=403)))
+        with pytest.raises(ConnectionError, match="HTTP 403"):
+            await reply.wait_ready()
+
+    asyncio.run(scenario())
