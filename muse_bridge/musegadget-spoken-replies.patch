+    service.Object = Object
+    service.method = service.signal = lambda *a, **k: lambda f: f
+    exceptions = ModuleType("dbus.exceptions")
+    exceptions.DBusException = type("DBusException", (Exception,), {})
+    mainloop = ModuleType("dbus.mainloop")
