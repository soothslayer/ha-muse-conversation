     assert printable("system.run") == "system.run"
     assert printable("a\nb\x1b[2Jc") == "a?b?[2Jc"
+
+
+def test_spoken_reply_uses_subscription_on_encrypted_session(monkeypatch):
+    monkeypatch.setattr("musegadget.chat_reply.SETTLE_S", .01)
+    async def scenario():
+        session, vm = make_session(lambda *a: {"ok": True}, [])
+        stop = asyncio.Event()
+        task = asyncio.create_task(session.run(stop))
+        await vm.handshake()
+        await vm.accept_control_stream()
+        await vm.next_message()
+        reply = asyncio.create_task(session.send_chat_and_wait("Hello", "ha-side"))
+        sub = await vm.next_frame()
+        assert sub.value.path == "/chat/subscribe"
+        await vm.send_frame(ServiceFrame.response(sub.stream_id, ApplicationResponse(status=200)))
+        request = await vm.next_frame()
+        assert request.value.path == "/chat/stream"
+        assert json.loads(request.value.body)["session_id"] == "ha-side"
+        busy = await session.send_chat_and_wait("Another", "other-side")
+        assert not busy["ok"] and "another voice request" in busy["error"]
+        # Subscription events can arrive before the delivery acknowledgment.
+        events = [
+            {"type": "event", "event": "message.assistant", "payload": {
+                "message_id": "bad", "parent_message_id": "other", "content": "Private"}},
+            {"type": "event", "event": "message.assistant", "payload": {
+                "message_id": "answer", "parent_message_id": "user", "content": "Hello back!"}},
+        ]
+        await vm.send_frame(ServiceFrame.body_chunk(sub.stream_id, BodyChunk(
+            data=b"".join(json.dumps(e).encode() + b"\n" for e in events))))
+        await vm.send_frame(ServiceFrame.response(request.stream_id, ApplicationResponse(
+            status=200, body=b'{"message_id":"user"}', end_body=True)))
+        result = await asyncio.wait_for(reply, 2)
+        assert result["reply"] == "Hello back!"
+        assert (await vm.next_frame()).kind == "reset"
+        assert not session._subscriptions
+        stop.set()
+        await task
+    asyncio.run(scenario())
+
+
+def test_reply_subscription_is_removed_on_cancellation():
+    async def scenario():
+        session, vm = make_session(lambda *a: {"ok": True}, [])
+        stop = asyncio.Event()
+        task = asyncio.create_task(session.run(stop))
+        await vm.handshake()
+        await vm.accept_control_stream()
+        await vm.next_message()
+        reply = asyncio.create_task(session.send_chat_and_wait("Hello"))
+        sub = await vm.next_frame()
+        reply.cancel()
+        with pytest.raises(asyncio.CancelledError):
+            await reply
+        reset = await vm.next_frame()
+        assert reset.kind == "reset" and reset.stream_id == sub.stream_id
+        assert not session._subscriptions and not session._reply_lock.locked()
+        stop.set()
+        await task
+    asyncio.run(scenario())
+
+
+@pytest.mark.parametrize("failure", ["timeout", "disconnect", "refused"])
+def test_reply_wait_failure_cleans_up_and_releases_busy_state(monkeypatch, failure):
+    monkeypatch.setattr("musegadget.link_client.REPLY_TIMEOUT_S", .1)
+    async def scenario():
+        session, vm = make_session(lambda *a: {"ok": True}, [])
+        stop = asyncio.Event()
+        task = asyncio.create_task(session.run(stop))
+        await vm.handshake()
+        await vm.accept_control_stream()
+        await vm.next_message()
+        reply = asyncio.create_task(session.send_chat_and_wait("Hello"))
+        sub = await vm.next_frame()
+        if failure == "refused":
+            await vm.send_frame(ServiceFrame.response(sub.stream_id, ApplicationResponse(status=403)))
+        else:
+            await vm.send_frame(ServiceFrame.response(sub.stream_id, ApplicationResponse(status=200)))
+            request = await vm.next_frame()
+            await vm.send_frame(ServiceFrame.response(request.stream_id, ApplicationResponse(
+                status=200, body=b'{"message_id":"user"}', end_body=True)))
+            if failure == "disconnect":
+                await vm.ws.close()
+        result = await asyncio.wait_for(reply, 2)
+        assert not result["ok"]
+        assert not session._subscriptions and not session._reply_lock.locked()
+        if failure == "refused":
+            assert "403" in result["error"]
+        elif failure == "timeout":
+            assert "Timed out" in result["error"]
+        else:
+            assert "disconnected" in result["error"]
+        stop.set()
+        await task
+    asyncio.run(scenario())
