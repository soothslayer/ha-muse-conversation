@@ -274,6 +281,49 @@ class LinkSession:
 
     # -- Sending --------------------------------------------------------------
 
+    async def send_chat_and_wait(self, message: str, session_id: str | None = None) -> dict:
+        """Subscribe before sending, then return correlated text for Assist.
+
+        The overall deadline includes subscription setup and the delivery ack.
+        A second voice turn fails promptly rather than building a stale queue.
+        Legacy send_chat remains acknowledgment-only for notifications.
+        """
+        if self._reply_lock.locked():
+            return {"ok": False, "error": "Muse is answering another voice request. Try again shortly."}
+        async with self._reply_lock:
+            try:
+                return await asyncio.wait_for(self._chat_reply(message, session_id), REPLY_TIMEOUT_S)
+            except asyncio.TimeoutError:
+                return {"ok": False, "error": "Timed out waiting for Muse's reply; the message may have been delivered."}
+            except (ConnectionError, ValueError) as exc:
+                return {"ok": False, "error": str(exc)}
+
+    async def _chat_reply(self, message: str, session_id: str | None) -> dict:
+        subscription = ChatReply(session_id)
+        encrypted = self._transport.encrypt_http_request(
+            "POST", "/chat/subscribe", b"{}",
+            headers=[Header("Content-Type", "application/json"),
+                     Header("Accept", "application/x-ndjson")],
+        )
+        stream_id = encrypted.stream_id
+        self._subscriptions[stream_id] = subscription
+        try:
+            await self._send_frames(encrypted.frames)
+            await asyncio.wait_for(subscription.wait_ready(), 10)
+            ack = await self.send_chat(message, session_id)
+            if not ack["ok"]:
+                return ack
+            subscription.bind_ack(ack.get("response"))
+            return {**ack, "reply": await subscription.wait_text()}
+        finally:
+            subscription.log_summary()
+            # If the session already ended, its cleanup removed the stream.
+            if self._subscriptions.pop(stream_id, None) is not None:
+                try:
+                    await self._send_frames(self._transport.encrypt_reset(stream_id))
+                except Exception:
+                    log.debug("could not close Muse reply subscription")
+
     async def send(self, message: dict) -> None:
         frames = self._transport.encrypt_body_chunk(self._stream_id, encode_message(message))
         await self._send_frames(frames)
