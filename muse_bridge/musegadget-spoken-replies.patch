+        service._current = FakeSession()
+        reader, writer = await asyncio.open_unix_connection(str(path))
+        writer.write(b'{"message":"hi"}\n')
+        await writer.drain()
+        writer.write_eof()
+        assert json.loads(await asyncio.wait_for(reader.readline(), 1))["ok"]
+        assert service._current.sent == [("hi", None)]
+        writer.close()
+        await writer.wait_closed()
+    run_with_socket(check)
