@@ -0,0 +1,205 @@
+# SPDX-License-Identifier: Apache-2.0
+# Reply protocol adapted from the Meta Muse gadget SDK ESP32 chat session.
+
+"""Collect a correlated Muse reply from the firmware's NDJSON subscription.
+
+Only parent-linked messages are accepted. Unattributed account-wide events
+must never become a spoken answer on an unrelated Home Assistant satellite.
+"""
+
+from __future__ import annotations
+
+import asyncio
+import json
+import time
+
+MAX_LINE_BYTES = 64 * 1024
+MAX_BUFFER_BYTES = 256 * 1024
+MAX_REPLY_BYTES = 8192
+SETTLE_S = 3.0
+
+
+class ChatReply:
+    """One subscription, opened before posting the user message."""
+
+    def __init__(self) -> None:
+        self.ready = asyncio.Event()
+        self.changed = asyncio.Event()
+        self.error: str | None = None
+        self._buffer = bytearray()
+        self._pending: list[dict] = []
+        self._pending_bytes = 0
+        self._roots: set[str] | None = None
+        self._messages: dict[str, dict] = {}
+        self._last_seq = 0
+        self._last_content = 0.0
+
+    def fail(self, message: str) -> None:
+        self.error = message
+        self.ready.set()
+        self.changed.set()
+
+    def on_frame(self, frame) -> None:
+        if self.error:
+            return
+        if frame.kind == "reset":
+            self.fail("Muse reply subscription was reset.")
+            return
+        if frame.kind == "response":
+            if not 200 <= frame.value.status < 300:
+                self.fail(
+                    f"Muse reply subscription refused: HTTP {frame.value.status}."
+                )
+                return
+            self.ready.set()
+            data, ended = frame.value.body, frame.value.end_body
+        else:
+            data, ended = frame.value.data, frame.value.end_body
+        self._buffer += data
+        while b"\n" in self._buffer and not self.error:
+            raw, _, rest = self._buffer.partition(b"\n")
+            self._buffer = bytearray(rest)
+            if len(raw) > MAX_LINE_BYTES:
+                self.fail("Muse reply event was too large.")
+                return
+            if not raw.strip():
+                continue
+            try:
+                event = json.loads(raw)
+            except (ValueError, UnicodeError):
+                self.fail("Muse sent an invalid reply event.")
+                return
+            if isinstance(event, dict):
+                self._event(event, len(raw))
+        if len(self._buffer) > MAX_LINE_BYTES:
+            self.fail("Muse reply event was too large.")
+        if ended:
+            self.fail("Muse reply subscription closed before the turn completed.")
+
+    def bind_ack(self, response) -> None:
+        """The POST acknowledgment names the parent IDs for this turn."""
+        if isinstance(response, dict) and isinstance(response.get("result"), dict):
+            response = response["result"]
+        if not isinstance(response, dict):
+            response = {}
+        self._roots = {
+            value
+            for key in ("message_id", "reply_to_message_id")
+            if isinstance(value := response.get(key), str) and value
+        }
+        if not self._roots:
+            self.fail(
+                "Muse accepted the message without a message ID; cannot match its reply."
+            )
+            return
+        for event in self._pending:
+            self._content(event)
+        self._pending.clear()
+        self._pending_bytes = 0
+
+    def _event(self, event: dict, size: int) -> None:
+        if event.get("type") != "event":
+            return
+        seq = event.get("seq")
+        if isinstance(seq, int) and seq > 0:
+            if seq <= self._last_seq:
+                return
+            self._last_seq = seq
+        if self._roots is None:
+            self._pending_bytes += size
+            if self._pending_bytes > MAX_BUFFER_BYTES or len(self._pending) >= 512:
+                self.fail(
+                    "Too many Muse events arrived before the delivery acknowledgment."
+                )
+                return
+            self._pending.append(event)
+        else:
+            self._content(event)
+
+    def _content(self, event: dict) -> None:
+        kind = event.get("event")
+        if kind not in {
+            "delta.message_start",
+            "delta.text_append",
+            "delta.message_done",
+            "message.assistant",
+        }:
+            return
+        payload = event.get("payload")
+        if not isinstance(payload, dict):
+            return
+        message_id = (
+            payload.get("message_id") or event.get("message_id") or payload.get("id")
+        )
+        if not isinstance(message_id, str) or not message_id:
+            return
+        parent = payload.get("reply_to_message_id") or payload.get("parent_message_id")
+        if parent and (
+            not isinstance(parent, str)
+            or parent not in self._roots
+            and parent not in self._messages
+        ):
+            return
+        if message_id not in self._messages:
+            if not parent:
+                return
+            if len(self._messages) >= 32:
+                self.fail("Muse returned too many reply messages.")
+                return
+            self._messages[message_id] = {"text": "", "done": False}
+        message = self._messages[message_id]
+        if message["done"]:
+            return
+        if kind == "delta.text_append":
+            text = payload.get("text")
+            if isinstance(text, str):
+                message["text"] += text
+        elif kind in {"delta.message_done", "message.assistant"}:
+            if (
+                kind == "message.assistant"
+                and payload.get("display_text_ready") is False
+            ):
+                return
+            text = payload.get("display_text")
+            if not isinstance(text, str):
+                text = payload.get("content")
+            if isinstance(text, str) and text:
+                message["text"] = text
+            message["done"] = True
+        if (
+            sum(len(m["text"].encode()) for m in self._messages.values())
+            > MAX_REPLY_BYTES
+        ):
+            self.fail("Muse's reply was too long to speak in one turn.")
+            return
+        self._last_content = time.monotonic()
+        self.changed.set()
+
+    async def wait_ready(self) -> None:
+        await self.ready.wait()
+        if self.error:
+            raise ConnectionError(self.error)
+
+    async def wait_text(self) -> str:
+        """No end-of-turn event exists; settle after all messages finish."""
+        while True:
+            self.changed.clear()
+            if self.error:
+                raise ConnectionError(self.error)
+            if self._messages and all(m["done"] for m in self._messages.values()):
+                remaining = SETTLE_S - (time.monotonic() - self._last_content)
+                if remaining <= 0:
+                    text = "\n\n".join(
+                        m["text"].strip()
+                        for m in self._messages.values()
+                        if m["text"].strip()
+                    )
+                    if text:
+                        return text
+                    raise ConnectionError("Muse completed the turn without reply text.")
+                try:
+                    await asyncio.wait_for(self.changed.wait(), remaining)
+                except asyncio.TimeoutError:
+                    pass
+            else:
+                await self.changed.wait()
